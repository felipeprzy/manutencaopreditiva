import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme(style="whitegrid")

# Carregamento dos dados
df = pd.read_csv('manutencao_preditiva.csv')

print(f"Dimensões do Dataset: {df.shape[0]} linhas e {df.shape[1]} colunas\n")
print("=== Tipos de Dados ===")
print(df.dtypes)
print("\n=== Resumo Estatístico Descritivo (.describe()) ===")
display(df.describe())

# 1. Histograma das variáveis preditoras
num_cols = df.select_dtypes(include=[np.number]).columns.tolist()
if 'Falha' in num_cols:
    num_cols.remove('falha_maquina')

df[num_cols].hist(bins=20, figsize=(12, 8), color='steelblue', edgecolor='black')
plt.suptitle("Histograma de Distribuição das Variáveis Preditoras", fontsize=14, fontweight='bold')
plt.tight_layout()
plt.show()

# 2. Gráfico de barras: Desbalanceamento do Target (falha_maquina)
plt.figure(figsize=(6, 4))
ax = sns.countplot(x='falha_maquina', data=df, palette='Set2')
plt.title("Taxa de Desbalanceamento da Variável Alvo (falha_maquina)", fontsize=12, fontweight='bold')
for p in ax.patches:
    ax.annotate(f'{int(p.get_height())}', (p.get_x() + p.get_width() / 2., p.get_height()),
                ha='center', va='center', xytext=(0, 5), textcoords='offset points')
plt.show()

# 3. Mapa de Calor (Correlação de Pearson)
plt.figure(figsize=(10, 8))
sns.heatmap(df.select_dtypes(include=[np.number]).corr(), annot=True, cmap='coolwarm', fmt=".2f")
plt.title("Mapa de Calor - Correlação de Pearson", fontsize=14, fontweight='bold')
plt.show()

# Remoção de duplicadas
duplicadas = df.duplicated().sum()
df = df.drop_duplicates().reset_index(drop=True)
print(f"Linhas duplicadas removidas: {duplicadas}")

# Imputação de nulos por média ou mediana com base na assimetria
for col in num_cols:
    if df[col].isnull().sum() > 0:
        skew_val = df[col].skew()
        if abs(skew_val) > 1:
            val = df[col].median()
            df[col].fillna(val, inplace=True)
            print(f"Coluna '{col}': Imputada por MEDIANA (Assimetria: {skew_val:.2f})")
        else:
            val = df[col].mean()
            df[col].fillna(val, inplace=True)
            print(f"Coluna '{col}': Imputada por MÉDIA (Assimetria: {skew_val:.2f})")

# Boxplot para outliers
plt.figure(figsize=(12, 6))
sns.boxplot(data=df[num_cols], palette="pastel")
plt.title("Análise de Outliers - Boxplot", fontsize=14, fontweight='bold')
plt.xticks(rotation=45)
plt.tight_layout()
plt.show()
# Identificação dinâmica das colunas de velocidade e torque para criar 'potencia'
col_vel = [c for c in df.columns if 'velocidade' in c.lower() or 'rpm' in c.lower()][0]
col_torq = [c for c in df.columns if 'torque' in c.lower()][0]

df['potencia'] = df[col_vel] * df[col_torq]
print(f"Feature 'potencia' criada com sucesso usando: {col_vel} * {col_torq}")
display(df[['potencia']].describe())

from sklearn.model_selection import train_test_split
from imblearn.over_sampling import SMOTE

# Selecionar colunas numéricas, remover a alvo e preencher eventuais NaNs remanescentes
X = df.select_dtypes(include=[np.number]).drop(columns=['falha_maquina']).fillna(df.median(numeric_only=True))
y = df['falha_maquina']

# Divisão 80/20 com estratificação
X_train, X_test, y_train, y_test = train_test_split(X, y, test_size=0.20, random_state=42, stratify=y)

# SMOTE aplicado exclusivamente nos dados de treino (evita Data Leakage)
smote = SMOTE(random_state=42)
X_train_res, y_train_res = smote.fit_resample(X_train, y_train)

print(f"X_train pós-SMOTE: {X_train_res.shape}")
print(f"Distribuição do Target no Treino:\n{y_train_res.value_counts()}")


from sklearn.preprocessing import StandardScaler

cont_cols = X_train_res.select_dtypes(include=[np.number]).columns.tolist()

# StandardScaler apenas para o KNN (fit_transform no treino, transform no teste)
scaler = StandardScaler()
X_train_knn = X_train_res.copy()
X_test_knn = X_test.copy()

X_train_knn[cont_cols] = scaler.fit_transform(X_train_res[cont_cols])
X_test_knn[cont_cols] = scaler.transform(X_test[cont_cols])

# Árvore de Decisão mantida sem escalonamento (imutável a escalas por divisões em thresholds)
X_train_tree = X_train_res.copy()
X_test_tree = X_test.copy()



from sklearn.neighbors import KNeighborsClassifier
from sklearn.tree import DecisionTreeClassifier
from sklearn.metrics import accuracy_score

print("=== KNN (Variação de K) ===")
knn_results = []
for k in [3, 5, 7]:
    knn = KNeighborsClassifier(n_neighbors=k)
    knn.fit(X_train_knn, y_train_res)
    acc_tr = accuracy_score(y_train_res, knn.predict(X_train_knn))
    acc_te = accuracy_score(y_test, knn.predict(X_test_knn))
    knn_results.append({'K': k, 'Treino': acc_tr, 'Teste': acc_te})
    print(f"K={k} -> Treino: {acc_tr:.4f} | Teste: {acc_te:.4f}")

print("\n=== Árvore de Decisão (Variação de max_depth) ===")
tree_results = []
for depth in [3, 5, None]:
    tree = DecisionTreeClassifier(max_depth=depth, random_state=42)
    tree.fit(X_train_tree, y_train_res)
    acc_tr = accuracy_score(y_train_res, tree.predict(X_train_tree))
    acc_te = accuracy_score(y_test, tree.predict(X_test_tree))
    tree_results.append({'max_depth': depth, 'Treino': acc_tr, 'Teste': acc_te})
    print(f"max_depth={depth} -> Treino: {acc_tr:.4f} | Teste: {acc_te:.4f}")
